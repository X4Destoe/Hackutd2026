# Secrets stay on the backend. Never use a VITE_ prefix for private API keys.
# After copying this file, restrict permissions: chmod 600 backend/.env
# Copy to backend/.env (never commit .env). Every value may stay blank: the app runs with the
# simulated Photon channel and template AI.
APP_BASE_URL=http://localhost:5173
PUBLIC_WEBHOOK_URL=                 # cloudflared URL for Photon webhooks, e.g. https://xyz.trycloudflare.com
LLM_PROVIDER=none                   # anthropic | openai | gemini | none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MESSAGING_MODE=sim                  # sim | photon
# Photon Spectrum (real texts). Create a project + iMessage line at app.photon.codes. Values go in backend/.env only.
SPECTRUM_PROJECT_ID=                # used by the Node bridge (backend/spikes/photon, npm start)
SPECTRUM_PROJECT_SECRET=            # used by the Node bridge
SPECTRUM_WEBHOOK_SECRET=            # verifies inbound webhooks (X-Spectrum-Signature)
SPECTRUM_SENDER=                    # optional: sending number when the project has several lines
PHOTON_BRIDGE_URL=http://127.0.0.1:8787
DEMO_PHONES=                        # +12145550101:TECH-HOU-01,+14695550102:TEN-001 (real phones for the live demo)
VITE_MAP_STYLE=                     # optional basemap style URL override (frontend)

# Current Photon HTTP API credentials (different from Spectrum project-secret auth above).
# Project API keys belong here, never in SPECTRUM_PROJECT_SECRET.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_DESTINATION_ID=
