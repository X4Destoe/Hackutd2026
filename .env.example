# Copy to backend/.env (never commit .env). Every value may stay blank: the app runs with the
# simulated Photon channel and template AI.
APP_BASE_URL=http://localhost:5173
PUBLIC_WEBHOOK_URL=                 # cloudflared URL for Photon webhooks, e.g. https://xyz.trycloudflare.com
LLM_PROVIDER=none                   # anthropic | openai | gemini | none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MESSAGING_MODE=sim                  # sim | photon
PHOTON_API_KEY=                     # VERIFY name/format in the Photon dashboard (TASK-010)
PHOTON_SENDER=                      # VERIFY
DEMO_PHONES=                        # +12145550101:TECH-HOU-01,+14695550102:TEN-001 (real phones for the live demo)
VITE_MAP_STYLE=                     # optional basemap style URL override (frontend)
